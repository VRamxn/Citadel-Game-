{
  "name": "citadel-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "abis": "node scripts/abis.mjs",
    "dev": "vite",
    "build": "npm run claims && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "e2e:basics": "node e2e/basics.mjs",
    "e2e:war": "node e2e/war.mjs",
    "claims": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});if(fs.existsSync('../data/claims.json'))fs.copyFileSync('../data/claims.json','public/claims.json')\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
